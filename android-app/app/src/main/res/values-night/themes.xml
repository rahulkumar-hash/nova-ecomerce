<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NovaStore" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#0B0F19</item>
        <item name="colorPrimaryVariant">#0B0F19</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#0B0F19</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="BottomNavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>
